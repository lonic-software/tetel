/target
.idea/

# Claude Code settings. `settings.json` is committed on purpose — it carries
# the hook that runs the pair-guards, and a guard that lives in one person's
# untracked config is not a guard the project has. Everything else under
# `.claude/` is personal (`settings.local.json`, transcripts, scratch).
.claude/*
!.claude/settings.json
# macOS Finder metadata.
.DS_Store

# Python (the checker prototype).
__pycache__/
*.pyc
.venv/

# Eval data lives in the tetel-eval-data repository, not here (TET-97): inside
# the worktree it matched almost every census tetel took of its own source.
# `scripts/verifier-eval/data.py` says where the scripts find it.
/scripts/verifier-eval/**/*.json
/scripts/verifier-eval/**/*.jsonl
