#!/usr/bin/env bash
# Option source for the release version picker: next patch / minor / major,
# computed from the latest vX.Y.Z tag; before the first tag, Cargo.toml's own
# version comes first. First line is the picker default.
set -euo pipefail
cd "$(dirname "$0")/.."

# Best effort — the picker should work offline; bin/release re-fetches and
# hard-fails on anything stale before touching the repo.
git fetch --tags --quiet 2>/dev/null || true

latest=$(git tag --list 'v*' --sort=-v:refname | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | head -1 || true)
latest=${latest#v}
if [ -z "$latest" ]; then
  # No release yet: the first one ships the version Cargo.toml already has.
  latest=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -1)
  echo "$latest"
fi

# A pre-release suffix (0.1.0-rc.1) bumps from its base version.
IFS=. read -r major minor patch <<<"${latest%%-*}"
echo "$major.$minor.$((patch + 1))"
echo "$major.$((minor + 1)).0"
echo "$((major + 1)).0.0"
