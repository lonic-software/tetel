{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/check-surfaces.sh",
            "statusMessage": "Checking surface parity...",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
